{
  "name": "wardendeck",
  "version": "0.1.0-prototype",
  "description": "Self-hosted, secure control plane for local AI coding agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bocoboho/wardendeck.git"
  },
  "homepage": "https://github.com/bocoboho/wardendeck#readme",
  "bugs": {
    "url": "https://github.com/bocoboho/wardendeck/issues"
  },
  "author": "WardenDeck contributors",
  "type": "module",
  "bin": {
    "wardendeck": "dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
