    "im",
    "approval",
    "audit"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0"
  }
}
